{
  // Startup
  "restore_on_startup": "launchpad",

  // Editor
  "vim_mode": true,
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "cursor_blink": false,

  // Interface
  "ui_font_size": 16,

  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte (lavender)",
    "dark": "Catppuccin Mocha (lavender)"
  },

  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },

  // Terminal
  "terminal": {
    "font_size": 13.0
  },

  // AI
  "disable_ai": true,

  // Privacy & Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  }
}
