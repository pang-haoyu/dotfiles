{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "Linux",
    "padding": {
      "top": 1,
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 16
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "󰣇  OS"
    },
    {
      "type": "kernel",
      "key": "󰒋  Kernel"
    },
    {
      "type": "uptime",
      "key": "󰔚  Uptime"
    },

    "break",

    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU"
    },
    {
      "type": "memory",
      "key": "  Memory"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": "/"
    },

    "break",

    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    }
  ]
}
