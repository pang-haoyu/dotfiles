{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo.png",
    "width": 40,
    "height": 20,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },

  "display": {
    "separator": "   ",
    "key": {
      "width": 15
    }
  },

  "bar": {
    "char": {
      "elapsed": "━",
      "total": "─"
    },
    "width": 22
  },

  "percent": {
    "type": 3,
    "color": {
      "green": "green",
      "yellow": "yellow",
      "red": "red"
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "bright_black",
        "host": "yellow"
      }
    },

    {
      "type": "custom",
      "format": "\u001b[90m────────────────────────────────────────────\u001b[0m"
    },

    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },

    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "blue"
    },

    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "blue"
    },

    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "blue"
    },

    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "blue"
    },

    {
      "type": "de",
      "key": "󰧨 Desktop",
      "keyColor": "blue"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[35m╭─ Hardware ────────────────────────────────────────────────────╮\u001b[0m"
    },

    {
      "type": "cpu",
      "key": "│  󰻠 CPU",
      "keyColor": "magenta",
      "format": "{name}"
    },

    {
      "type": "gpu",
      "key": "│  󰢮 GPU",
      "keyColor": "magenta",
      "format": "{name}"
    },

    {
      "type": "memory",
      "key": "│  󰍛 Memory",
      "keyColor": "magenta",
      "percent": {
        "type": 3
      }
    },

    {
      "type": "disk",
      "key": "│  󰋊 Disk",
      "keyColor": "magenta",
      "folders": "/",
      "percent": {
        "type": 3
      }
    },

    {
      "type": "custom",
      "format": "\u001b[35m╰───────────────────────────────────────────────────────────────╯\u001b[0m"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[36m╭─ Session ───────────────────────────────────────╮\u001b[0m"
    },

    {
      "type": "display",
      "key": "│  󰍹 Display",
      "keyColor": "cyan"
    },

    {
      "type": "packages",
      "key": "│  󰏖 Packages",
      "keyColor": "cyan"
    },

    {
      "type": "localip",
      "key": "│  󰩟 Local IP",
      "keyColor": "cyan"
    },

    {
      "type": "battery",
      "key": "│  󰁹 Battery",
      "keyColor": "cyan"
    },

    {
      "type": "custom",
      "format": "\u001b[36m╰─────────────────────────────────────────────────╯\u001b[0m"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
